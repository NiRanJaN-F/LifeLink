# ==============================================================================
# LifeLink Backend Environment Configuration
# Copy this file to .env and configure values before starting the server.
# NEVER commit the actual .env file or production secrets to version control.
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# Database Connection Settings (Local MySQL or AWS RDS MySQL)
DB_HOST=your-rds-endpoint.czxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=lifelink_admin
DB_PASSWORD=replace_with_strong_rds_password
DB_NAME=lifelink_db

# Connection Pool Settings (Optional)
DB_CONNECTION_LIMIT=10

# Database SSL (Set to 'true' when connecting to AWS RDS MySQL over SSL)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Authentication Secret (Must be a cryptographically secure random string, min 32 characters)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_key

# Frontend Client URL for CORS
# In production, set to your CloudFront distribution domain or custom domain (e.g. https://d1234abcd.cloudfront.net)
# Can be comma-separated if supporting both CloudFront domain and a custom apex domain.
CLIENT_URL=https://your-cloudfront-id.cloudfront.net