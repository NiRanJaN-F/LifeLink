# ==============================================================================
# LifeLink Frontend Environment Configuration
# Copy this file to .env or .env.production before running or building.
# Note: Any variable prefixed with VITE_ is bundled into client-side JavaScript.
# NEVER put private secrets, database passwords, or JWT secrets here.
# ==============================================================================

# Backend API base URL
# Local Development:
VITE_API_URL=http://localhost:5000/api

# Production (Set before running `npm run build`):
# If using an EC2 instance with HTTPS or an Application Load Balancer / Nginx:
# VITE_API_URL=https://api.yourdomain.com/api
# Or direct EC2 Public DNS (with Nginx SSL):
# VITE_API_URL=https://ec2-xx-xx-xx-xx.compute-1.amazonaws.com/api
